# ---- Required ----
DATABASE_URL="postgresql://careerpoint:careerpoint@localhost:5433/careerpoint?schema=public"
# Public https origin of the site. Used for canonical URLs, sitemap, emails and the CSRF origin check.
APP_URL="http://localhost:3000"
# Signs short-lived file links. REQUIRED in production (16+ random chars): openssl rand -hex 32
AUTH_SECRET=""
# Private file storage root (never served statically; mount a persistent volume in production)
STORAGE_DIR="./storage"

# ---- Email (optional; without SMTP_URL emails are only written to the server log) ----
SMTP_URL=""
MAIL_FROM="CareerPoint <no-reply@careerpoint.local>"

# ---- Bootstrap admin (npm run db:seed). The example password is refused in production. ----
SEED_ADMIN_EMAIL="admin@careerpoint.local"
SEED_ADMIN_PASSWORD="ChangeMe-Admin-123"

# ---- AI assistance (optional; every output needs the user's approval; keys never reach the browser) ----
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"
# Tried when the primary model keeps failing (optional)
AI_FALLBACK_MODEL=""
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
# Cost protection
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_INPUT_CHARS=9000
AI_USER_DAILY_LIMIT=30
AI_DAILY_TOKEN_BUDGET=400000

# ---- Observability ----
# debug | info | warn | error  (structured JSON logs on stdout/stderr)
LOG_LEVEL="info"
